# Pins the OpenTelemetry Demo to release 3.1.0.
# scripts/apply_demo_extras.sh copies this file to the demo checkout as .env.override.
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0
# Re-declared so that service.version follows IMAGE_VERSION above: .env resolves it as it is read.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION}