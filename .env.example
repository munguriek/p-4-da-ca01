# RouteWatch settings. Copy to .env and fill in the three blank values; .env is never committed.

# Kafka KRaft cluster id, written into Kafka's data volume on first start.
# Generate once:  docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
ROUTEWATCH_KAFKA_CLUSTER_ID=

# Kafka as the laptop reaches it: compose.routewatch.yaml publishes 127.0.0.1:39092.
ROUTEWATCH_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:39092
# The topic the collector writes and the raw consumer reads.
ROUTEWATCH_KAFKA_TOPIC=routewatch.ris.raw
# The raw consumer's group: its committed offsets record how far it has read.
ROUTEWATCH_KAFKA_GROUP_ID=routewatch.raw.v1

# PostgreSQL: compose.routewatch.yaml publishes 127.0.0.1:5434.
# Generate the password once:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ROUTEWATCH_POSTGRES_PASSWORD=
ROUTEWATCH_POSTGRES_HOST=127.0.0.1
ROUTEWATCH_POSTGRES_PORT=5434
ROUTEWATCH_POSTGRES_DB=routewatch
ROUTEWATCH_POSTGRES_USER=routewatch

# Web UI: scripts/serve_routewatch_ui.py connects as this read-only role.
# Generate the password the same way, then run:  python scripts/init_routewatch_ui_role.py
ROUTEWATCH_UI_POSTGRES_USER=routewatch_ui
ROUTEWATCH_UI_POSTGRES_PASSWORD=

# Set to 1 to run the clean-storage database tests with pytest -m integration.
# ROUTEWATCH_RUN_INTEGRATION=1

# Optional, on the VM only: publish the UI through a Cloudflare Tunnel
# (docs/deploy.md). The token is a secret: keep it in .env alone.
# ROUTEWATCH_UI_PUBLIC_HOST=demo.example.org
# ROUTEWATCH_TUNNEL_TOKEN=
