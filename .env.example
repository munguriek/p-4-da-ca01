# Kafka KRaft cluster id, written into Kafka's data volume on first start.
# Generate once:  docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# Password for the PostgreSQL user "pipeline".
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=